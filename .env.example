# Local development uses a persistent embedded PostgreSQL-compatible database (PGlite).
# Set DATABASE_URL to a PostgreSQL connection string for a hosted/production database.
DATABASE_URL=

# Generate with: openssl rand -hex 32 (at least 32 characters; never commit this value).
AUTH_SECRET=

# OpenAI-compatible chat completions provider. Required for the AI tools only.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Public origin (needed to construct password-reset links). No trailing slash.
APP_URL=http://localhost:3000

# Set all of these for password reset by email in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: development-only reset links in the server console, never enable in production.
DEV_RESET_LINK_LOG=false
